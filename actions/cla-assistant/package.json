{
  "name": "github-action",
  "version": "0.0.1",
  "description": "GitHub Action for storing CLA signatures",
  "main": "lib/main.js",
  "type": "module",
  "scripts": {
    "test": "tsc && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "build": "tsc && ncc build lib/main.js && node scripts/normalize-bundle.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cla-assistant/github-action.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.0.0"
  },
  "devDependencies": {
    "@octokit/types": "18.0.0",
    "@types/node": "26.6.6",
    "@vercel/ncc": "0.45.0",
    "typescript": "7.0.2",
    "jest": "30.5.2"
  },
  "author": "ibakshay",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/cla-assistant/github-action/issues"
  },
  "homepage": "https://github.com/cla-assistant/github-action#readme",
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "transform": {}
  }
}
